#Functions
def time_seconds_converter(time):
    years, days, hours, minutes, seconds = time
    days = days + (years * 426)
    hours = hours + (days * 6)
    minutes = minutes + (hours * 60)
    seconds = seconds + (minutes * 60)
    print(f'Time_to_seconds: {seconds}')
    return seconds

def orbital_velocity_predictor(radius_orbital,mass_of_body):
    orbital_velocity = ((G*mass_of_body)/radius_orbital)**0.5
    print(f'Orbital velocity: {orbital_velocity}')
    return orbital_velocity

def orbital_radius(orbital_velocity, period):
    radius_orbital = (orbital_velocity*period)/(2*math.pi)
    print(f'Orbital radius: {radius_orbital}')
    return radius_orbital

def mass_of_body(orbital_velocity, radius_orbital):
    calculated_mass = ((radius_orbital*(orbital_velocity**2))/G)
    print(f'Mass of body: {calculated_mass}')
    return calculated_mass

def gravitational_acceleration(radius_orbital,mass_of_body):
    acceleration_gravitational = (G*mass_of_body)/(radius_orbital*radius_orbital)
    print(f'Gravitational acceleration at {radius_orbital}m: {acceleration_gravitational}')
    return acceleration_gravitational

def low_height_dv(surface_g,target_height):
    delta_v_launch = math.sqrt(2 * surface_g * target_height)
    print(f'Launch_dv: {delta_v_launch}')
    return delta_v_launch

def calculate_launch_dv_high_altitude(M, Ro, Rf):
    if Ro <= 0 or Rf <= 0:
        return 0.0
    r_initial = Ro
    r_final = Rf
    delta_v_squared = 2 * G * M * ((r_final - r_initial) / (r_initial * r_final))
    dv_launch = math.sqrt(delta_v_squared)
    print(f"Launch_dv_high: {dv_launch}")
    return dv_launch

def dv_to_raise_apoapsis_true(M, R, h_current, h_target, v_current=0):
    # GM (Gravitational Parameter)
    mu = 6.674e-11 * M

    # Radii from center of mass
    rp = R + h_current
    ra = R + h_target

    # Semi-major axis of the new transfer ellipse
    a = (rp + ra) / 2

    # Vis-viva: Velocity needed at rp to have an apoapsis at ra
    v_needed = math.sqrt(mu * (2/rp - 1/a))

    # The dv is the difference between needed and what you already have
    dv = v_needed - v_current

    print(f"DV required for Apoapsis at {h_target}m: {dv:.2f} m/s")
    return dv

def hohmann_transfer_dv(r1, r2, mass_of_body):
    a_transfer = (r1 + r2) / 2
    v1_circular = math.sqrt(G*mass_of_body/ r1)
    v2_circular = math.sqrt(G*mass_of_body/ r2)
    v_periapsis_transfer = math.sqrt(G*mass_of_body* ((2 / r1) - (1 / a_transfer)))
    v_apoapsis_transfer = math.sqrt(G*mass_of_body * ((2 / r2) - (1 / a_transfer)))
    delta_v1 = v_periapsis_transfer - v1_circular
    delta_v2 = v2_circular - v_apoapsis_transfer
    period_transfer = 2 * math.pi * math.sqrt(a_transfer**3 / (G*mass_of_body))
    time_of_flight = period_transfer / 2
    print(f"Hohmann transfer:\ndv1: {delta_v1}\ndv2: {delta_v2}")

def geostationary_orbit_r(mass_of_body, body_rotational_time, radius_of_body_km):
    r_cubed = (G * mass_of_body * (body_rotational_time**2)) / (4 * math.pi**2)
    r = r_cubed**(1/3)
    r_km = r / 1000
    height = r_km - radius_of_body_km
    print(f"Geostationary height of body in km: {height}")
    return r_km

def landing_dv(height_r, ground_r, mass_of_body):
    dv_to_land = math.sqrt(2*G*mass_of_body*((1/ground_r)-(1/(height_r))))
    print(f"Approximate space-to-crash dv:{dv_to_land}")
    return dv_to_land

def surface_gravity_calculator(radius,mass):
    surface_g = (G * mass)/(radius**2)
    print(f"Surface gravity g: {surface_g}")
    return surface_g

def calculate_phase_angle(r1, r2, mass_of_central_body):
    a_transfer = (r1 + r2) / 2
    period_transfer = 2 * math.pi * math.sqrt(a_transfer**3 / (G * mass_of_central_body))
    time_of_flight = period_transfer / 2
    angular_velocity_target = math.sqrt((G * mass_of_central_body) / r2**3)
    angle_target_moves = angular_velocity_target * time_of_flight
    phase_angle_rad = math.pi - angle_target_moves
    phase_angle_deg = math.degrees(phase_angle_rad)
    print(f"--- Transfer Calculation ---")
    print(f"Time of Flight: {time_of_flight / 60:.2f} minutes")
    print(f"Required Phase Angle: {phase_angle_deg:.2f} degrees")
    return phase_angle_deg

def sma_from_altitudes(apoapsis_alt, periapsis_alt, body_radius):
    r_ap = apoapsis_alt + body_radius
    r_pe = periapsis_alt + body_radius
    a = (r_ap + r_pe) / 2
    print(f"Semi-Major Axis (Geometry): {a} m")
    return a

def visualize_orbital_velocity(mass_of_body, min_alt, max_alt):
    # Generate altitudes from 70km (KSP atmosphere edge) to 1000km
    altitudes = np.linspace(min_alt, max_alt, 100)
    velocities = [orbital_velocity_predictor(600000 + a, mass_of_body) for a in altitudes]

    plt.figure(figsize=(8, 5))
    plt.plot(altitudes / 1000, velocities, color='tab:blue', linewidth=2)
    plt.title("Orbital Velocity vs. Altitude (Kerbin)")
    plt.xlabel("Altitude (km)")
    plt.ylabel("Velocity (m/s)")
    plt.grid(True)
    plt.show() # This will appear in Spyder's "Plots" pane


